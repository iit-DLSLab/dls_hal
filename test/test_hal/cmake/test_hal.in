#!/bin/bash
set -eo pipefail

export PYTHONPATH="@TEST_HAL_DLS_PYTHON_ROOT@${PYTHONPATH:+:$PYTHONPATH}"
RUNTIME_ROOT="@TEST_HAL_RUNTIME_ROOT@"

PREFERRED_DLS2_PYTHON="${DLS2_PYTHON:-@TEST_HAL_SHARED_PYTHON@}"
DLS2_PYTHON="$PREFERRED_DLS2_PYTHON"
if [ ! -x "$DLS2_PYTHON" ]; then
    echo "test_hal: missing shared DLS2 interpreter at $DLS2_PYTHON" >&2
    exit 127
fi
PYTHON_EXECUTABLE="$DLS2_PYTHON"

DLS_SETUP_SCRIPT="@TEST_HAL_DLS_PYTHON_ROOT@/dls2_py/scripts/setup.sh"
if [ -f "$DLS_SETUP_SCRIPT" ]; then
    # shellcheck disable=SC1090
    export COLCON_PYTHON_EXECUTABLE="${COLCON_PYTHON_EXECUTABLE:-$PYTHON_EXECUTABLE}"
    export COLCON_TRACE="${COLCON_TRACE:-}"
    export AMENT_TRACE_SETUP_FILES="${AMENT_TRACE_SETUP_FILES:-}"
    source "$DLS_SETUP_SCRIPT"
fi

exec "$PYTHON_EXECUTABLE" "$RUNTIME_ROOT/python/test_hal.py" "$@"
